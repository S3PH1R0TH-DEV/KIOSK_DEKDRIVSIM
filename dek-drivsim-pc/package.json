{
  "name": "dek-drivsim-pc",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "DEK-DRIVSIM CyberCafe - PC Kiosk (Electron) + Mobile (Capacitor)",
  "author": "DEK-DRIVSIM",
  "repository": {
    "type": "git",
    "url": "https://github.com/S3PH1R0TH-DEV/KIOSK_DEKDRIVSIM.git"
  },
  "main": "electron-main.cjs",
    "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron electron-main.cjs\"",
    "build": "tsc && vite build",
    "build:electron": "npm run build && electron-builder --publish never",
    "build:electron:win": "npm run build && electron-builder --win --x64 --publish never",
    "preview": "vite preview",
    "electron": "electron electron-main.cjs",
    "electron:dev": "cross-env NODE_ENV=development electron electron-main.cjs",
    "capacitor:add:android": "npx cap add android",
    "capacitor:sync": "npx cap sync",
    "capacitor:open:android": "npx cap open android",
    "capacitor:build:android": "npm run build && npx cap sync android",
    "lint": "eslint src --ext ts,tsx"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@vitejs/plugin-react": "^6.1.0",
    "axios": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "build": {
    "appId": "com.dek.drivsim",
    "productName": "DEK-DRIVSIM CyberCafe",
    "copyright": "Copyright © 2026 DEK-DRIVSIM",
    "artifactName": "dekdrivsim.${ext}",
    "publish": null,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "assets/**/*",
      "!**/node_modules/*/{CHANGES.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/*.ts",
      "!**/node_modules/*/example*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DEK-DRIVSIM CyberCafe",
      "uninstallDisplayName": "DEK-DRIVSIM CyberCafe",
      "license": "LICENSE.txt"
    },
    "extraResources": [
      {
        "from": "../cybercafe_manager",
        "to": "cybercafe_manager",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true
  }
}
